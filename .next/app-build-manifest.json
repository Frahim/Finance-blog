{
  "pages": {
    "/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/page.css",
      "static/chunks/app/page.js"
    ],
    "/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/layout.css",
      "static/chunks/app/layout.js"
    ],
    "/post/[uri]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/post/[uri]/page.css",
      "static/chunks/app/post/[uri]/page.js"
    ],
    "/contact/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/contact/page.js"
    ],
    "/category/[slug]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/category/[slug]/page.js"
    ],
    "/pages/[slug]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/pages/[slug]/page.css",
      "static/chunks/app/pages/[slug]/page.js"
    ],
    "/_not-found/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/_not-found/page.js"
    ]
  }
}